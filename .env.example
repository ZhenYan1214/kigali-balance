# Kigali Balance environment template.
# Copy to .env (git-ignored) and fill in locally. Never commit .env.
# Foundry loads .env from the repository root automatically (forge script / cast).
#
# Use a FRESH TEST-ONLY wallet. Sepolia ETH has no value; never put a key that holds real funds here.

# ------------------------------------------------------------------ OP Sepolia (chain 11155420): demo deployment target
# KigaliLedger needs ~29.7M gas on Sepolia after its Amsterdam upgrade, above the 16.78M per-transaction
# cap, so the demo deploys to OP Sepolia (~4.1M). The public endpoint works but is rate-limited; for the
# real broadcast prefer your provider, e.g. Alchemy: https://opt-sepolia.g.alchemy.com/v2/<key>
OP_SEPOLIA_RPC_URL=https://sepolia.optimism.io

# ------------------------------------------------------------------ Sepolia (L1 testnet; checks only for now)
# HTTPS RPC endpoint, e.g. from Alchemy, Infura or a public Sepolia RPC
SEPOLIA_RPC_URL=

# Private key of the test deployer wallet, 0x-prefixed 64 hex characters.
# Fund it with OP Sepolia ETH from a faucet. It deploys the contracts and funds the demo actors.
DEPLOYER_PRIVATE_KEY=

# Etherscan API key (Etherscan API v2 covers OP Sepolia), used to verify the contracts so judges
# can read the source on sepolia-optimism.etherscan.io
ETHERSCAN_API_KEY=

# ------------------------------------------------------------------ optional
# Separate test key that writes AI flags to FlagRegistry (role AI_ORACLE). Leave empty to reuse the deployer.
AI_ORACLE_PRIVATE_KEY=
